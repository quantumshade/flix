{
	"languages": {
		"TOML": {
			"format_on_save": "on",
			"formatter": { "language_server": { "name": "tombi" } },
		},
	},
	"lsp": {
		"rust-analyzer": {
			"initialization_options": {
				"imports": {
					"granularity": { "enforce": true, "group": "module" },
					"group": { "enable": true },
					"merge": { "glob": false },
					"preferNoStd": true,
				},
				"server": {
					"extraEnv": {
						"RUSTUP_TOOLCHAIN": "stable",
					},
				},
			},
		},
	},
}
