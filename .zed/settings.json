{
	"lsp": {
		"just-lsp": {
			"initialization_options": {
				"formatting": {
					"indentation": "\t",
				},
			},
		},
		"rust-analyzer": {
			"initialization_options": {
				"imports": {
					"granularity": { "enforce": true, "group": "module" },
					"group": { "enable": true },
					"merge": { "glob": false },
					"preferNoStd": true,
				},
				"server": {
					"extraEnv": {
						"RUSTUP_TOOLCHAIN": "stable",
					},
				},
			},
		},
	},
}
